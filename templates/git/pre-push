#!/usr/bin/env bash
# =============================================================================
# Harness Sovereign — Pre-Push Gates (esteira DevSecOps local)
# Template do kit: adaptado do pre-push dos repositórios do Sovereign Pair.
# =============================================================================
# Roda LOCALMENTE o que a esteira remota não bloqueia. Achado de 2026-09-05: no
# `.github/workflows/devsecops.yml` o job agregado só marca `failure` para
# `pipeline-security` e `sast-semgrep`; Trivy vira `::warning::` e os gates de
# tipagem/teste terminam em `|| true`. Consequência medida: as 6 vulnerabilidades
# `high` que existiam nos 7 repositórios de frontend jamais teriam reprovado um
# merge. Some-se a isso a política de `[skip ci]` por padrão (custo de runner) e
# o bloqueio de billing da organização desde 2026-08-27: na prática NENHUM gate
# roda antes de o código chegar ao remoto. Este hook é esse portão.
#
# Instalação (por repositório, uma vez — `core.hooksPath` é config local e não
# viaja no clone):
#     git config core.hooksPath .githooks
#
# Escape explícito, para build local / push de emergência:
#     HARNESS_SKIP=all         git push
#     HARNESS_SKIP=trivy,test  git push
# Gates: gitleaks, trivy, semgrep, types, test, lint
#
# Ferramenta ausente BLOQUEIA (fail-loud, Zero-Trust): sem verificação, sem
# push. Use o escape acima se a ausência for consciente.
# =============================================================================
set -uo pipefail

# O git invoca hooks com GIT_DIR (e às vezes GIT_WORK_TREE/GIT_INDEX_FILE)
# apontando pro .git deste repo. Tudo que os gates spawnam herda — inclusive
# o `cargo test`, cujos testes de harness executam `git` REAL em repositórios
# temporários: com GIT_DIR forçado, cada comando opera no repo errado e
# dezenas de testes reprovam juntos (medido em 2026-09-08: 34-36 falhas nas
# famílias harness_git/network/sandbox, zero nos testes do diff; sem GIT_DIR,
# os mesmos testes passam). O hook não depende dessas vars (resolve a raiz
# por descoberta a partir do cwd), então limpar aqui é seguro pros gates e
# pros filhos deles.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"
REPO_NAME=$(basename "$REPO_ROOT")

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; BLUE='\033[0;34m'; NC='\033[0m'

SKIP="${HARNESS_SKIP:-}"
FAILED=()

skipped() {
    [ "$SKIP" = "all" ] && return 0
    case ",$SKIP," in *",$1,"*) return 0 ;; esac
    return 1
}

# --- Faixa de commits sendo enviada -----------------------------------------
# O git entrega em stdin: <local_ref> <local_sha> <remote_ref> <remote_sha>.
# Serve para escopar o lint ao que está sendo ENVIADO, e não ao repositório
# inteiro: há dívida de formatação pré-existente (25 a 40 arquivos por repo em
# 2026-09-06), então um `prettier --check .` bloquearia todo push a partir de
# hoje. Verificar o que você está mandando quita a dívida incrementalmente.
ZERO='0000000000000000000000000000000000000000'
RANGE=''
REFS_TOTAL=0
REFS_DELETE=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
    REFS_TOTAL=$((REFS_TOTAL + 1))
    if [ "${local_sha:-$ZERO}" = "$ZERO" ]; then
        REFS_DELETE=$((REFS_DELETE + 1))
        continue
    fi
    if [ "${remote_sha:-$ZERO}" = "$ZERO" ]; then
        base=$(git merge-base "$local_sha" origin/main 2>/dev/null || true)
        [ -n "$base" ] && RANGE="$base..$local_sha"
    else
        RANGE="$remote_sha..$local_sha"
    fi
done

# Deleção de ref (`git push --delete`, `git push origin :branch`): o git entrega
# `local_sha` zerado e NADA está sendo enviado. Rodar os gates aqui avalia a
# working tree ATUAL, que numa deleção não tem relação nenhuma com o ref sendo
# apagado — em 2026-09-09 isso bloqueou uma limpeza legítima, com o `trivy`
# reprovando por uma vulnerabilidade que já estava corrigida em `main` mas ainda
# vivia na branch que por acaso estava em checkout. É a terceira encarnação da
# classe "o gate avalia algo diferente do que está sendo enviado" (as outras
# duas: `cargo fmt` enumerando os targets do crate; `rustfmt` atravessando
# declarações `mod`), aqui em grau máximo.
#
# A saída exige que TODOS os refs do push sejam deleção: um push misto
# (deleta uma branch e envia outra) continua passando pelos gates inteiros. E
# exige REFS_TOTAL > 0 — sem nenhum ref lido, o fluxo segue normal, para que um
# stdin inesperado nunca vire um caminho silencioso de pular verificação.
if [ "$REFS_TOTAL" -gt 0 ] && [ "$REFS_DELETE" -eq "$REFS_TOTAL" ]; then
    echo ""
    echo -e "${BLUE}━━━ harness · pre-push gates · ${REPO_NAME} ━━━${NC}"
    echo -e "${GREEN}⏭  deleção de ref — nada sendo enviado, os gates não se aplicam.${NC}"
    echo ""
    exit 0
fi

CHANGED_FILES=''
if [ -n "$RANGE" ]; then
    CHANGED_FILES=$(git diff --name-only --diff-filter=ACMR "$RANGE" 2>/dev/null || true)
fi

echo ""
echo -e "${BLUE}━━━ harness · pre-push gates · ${REPO_NAME} ━━━${NC}"
[ -n "$SKIP" ] && echo -e "${YELLOW}⚠️  HARNESS_SKIP=${SKIP} — pulando gate(s) por decisão explícita${NC}"

# run_gate <nome> <comando...>
run_gate() {
    local nome="$1"; shift
    if skipped "$nome"; then
        echo -e "${YELLOW}⏭  ${nome}: pulado (HARNESS_SKIP)${NC}"
        return 0
    fi
    local ini fim out rc dur
    ini=$(date +%s)
    if ! out=$(mktemp "${TMPDIR:-/tmp}/sovereign-pre-push.${REPO_NAME}.${nome}.XXXXXX.log"); then
        echo -e "${RED}❌ ${nome}: não foi possível criar o log diagnóstico seguro${NC}"
        FAILED+=("$nome")
        return
    fi
    if ! chmod 600 "$out"; then
        echo -e "${RED}❌ ${nome}: não foi possível restringir o log diagnóstico${NC}"
        rm -f "$out"
        FAILED+=("$nome")
        return
    fi
    "$@" >"$out" 2>&1; rc=$?
    fim=$(date +%s); dur=$((fim - ini))
    if [ "$rc" -eq 0 ]; then
        rm -f "$out" || echo -e "${YELLOW}⚠️  ${nome}: log de sucesso não pôde ser removido: ${out}${NC}"
        echo -e "${GREEN}✅ ${nome}${NC} (${dur}s)"
    else
        echo -e "${RED}❌ ${nome}${NC} (${dur}s)"
        echo -e "${YELLOW}   Saída completa preservada em: ${out}${NC}"
        FAILED+=("$nome")
    fi
}

# precisa_de <binario> <como instalar> — chamado DENTRO do gate, nunca em volta
# dele: acoplar a checagem de binário ao `if` externo fazia pular um gate pular
# também o seguinte (medido ao testar o hook em 2026-09-06 — `SKIP=types`
# desligava o `test` junto, silenciosamente).
precisa_de() {
    local bin="$1" como="$2"
    command -v "$bin" >/dev/null 2>&1 && return 0
    echo "\`${bin}\` não encontrado nesta máquina — sem verificação, sem push."
    echo "Instale: ${como}"
    return 127
}

# =============================================================================
# Gate 1 — Gitleaks (segredos). Roda LOCALMENTE por decisão técnica: na esteira
# do GitHub, o gitleaks exige licença paga para repositórios de Organization.
# =============================================================================
gate_gitleaks() {
    precisa_de gitleaks "https://github.com/gitleaks/gitleaks/releases (ou brew install gitleaks)" || return 127
    # `-v` é necessário: sem ele o gitleaks reprova sem dizer O QUE achou (medido
    # em 2026-09-06 — o gate bloqueou um push imprimindo nada). `--redact` mantém
    # o valor mascarado como REDACTED, então o achado é diagnosticável sem que o
    # segredo entre no terminal, no log da sessão ou no contexto de um agente.
    local args=(detect --source . --no-banner --redact -v --exit-code 1)
    [ -f ".gitleaks.toml" ] && args+=(--config .gitleaks.toml)
    # O baseline já foi validado no fluxo principal (`valida_baseline_gitleaks`),
    # antes de qualquer gate rodar — aqui ele só entra nos argumentos.
    [ -f ".gitleaks-baseline.json" ] && args+=(--baseline-path .gitleaks-baseline.json)
    gitleaks "${args[@]}"
}
# -----------------------------------------------------------------------------
# Baseline do gitleaks: exceções item a item, e as guardas que impedem que ele
# vire o buraco (desenho de 2026-09-09).
#
# O baseline suprime por fingerprint `commit:arquivo:regra:linha`, então um
# segredo NOVO — inclusive no mesmo arquivo — continua reprovando. Foi o que
# substituiu a allowlist por caminho, que desligava a regra no arquivo inteiro:
# medido com dois canários sintéticos em commit novo, ela detectava 1 de 2.
#
# Isto roda ANTES dos gates, e no fluxo principal em vez de dentro do
# `gate_gitleaks`, por dois motivos: a contagem do que está sendo suprimido
# precisa aparecer em TODO push (o `run_gate` só mostra a saída de quem falha, e
# uma exceção silenciosa é como se chega a um scanner que não protege mais nada),
# e um baseline inválido tem de derrubar o push antes de qualquer trabalho.
#
# Nenhuma das guardas é aviso: todas BLOQUEIAM. Um scanner de segredo que degrada
# em silêncio é pior do que scanner nenhum, porque passa confiança.
# -----------------------------------------------------------------------------
valida_baseline_gitleaks() {
    [ -f ".gitleaks-baseline.json" ] || return 0
    skipped gitleaks && return 0

    # (1) o baseline não pode ser, ele próprio, um vazamento — nem estar quebrado.
    local relato
    if ! relato=$(python3 - <<'PYEOF'
import json, sys
try:
    itens = json.load(open('.gitleaks-baseline.json'))
except Exception as e:
    print(f"baseline ilegível: {e}")
    sys.exit(1)
if not isinstance(itens, list):
    print("baseline não é uma lista de achados")
    sys.exit(1)
claros = [f for f in itens
          if f.get('Secret') != 'REDACTED' or 'REDACTED' not in str(f.get('Match', ''))]
if claros:
    print(f"{len(claros)} entrada(s) com valor EM CLARO — regenere com --redact:")
    for f in claros[:5]:
        print(f"    · {f.get('File')}:{f.get('StartLine')} ({f.get('RuleID')})")
    sys.exit(1)
print(f"{len(itens)}")
PYEOF
    ); then
        echo -e "${RED}❌ baseline do gitleaks rejeitado${NC}"
        echo "$relato" | sed 's/^/   /'
        echo -e "${YELLOW}   Corrija o arquivo. Não existe caminho para pular esta verificação.${NC}"
        exit 1
    fi

    # (2) exceção que não aparece em diff é o problema, não a solução.
    if ! git ls-files --error-unmatch .gitleaks-baseline.json >/dev/null 2>&1; then
        echo -e "${RED}❌ .gitleaks-baseline.json não está rastreado pelo git${NC}"
        echo -e "${YELLOW}   Uma exceção de segurança invisível no diff não vale. Versione o arquivo.${NC}"
        exit 1
    fi

    echo -e "${BLUE}🔎 gitleaks: ${relato} achado(s) já analisado(s) e suprimido(s) pelo baseline${NC}"
    echo -e "${BLUE}   Prova de que ele não cega o scanner: ./scripts/verify_gitleaks_baseline.sh${NC}"
}

# -----------------------------------------------------------------------------
# Aviso `base` — a branch está atrás de `origin/main`?
#
# HISTÓRICO, porque a primeira versão disto estava ERRADA e vale a lição: em
# 2026-09-09 este bloco nasceu como GATE BLOQUEANTE, na crença de que uma branch
# derivada de `main` desatualizado reverteria, no merge, o que `main` ganhou nesse
# intervalo. **Medido no dia seguinte, é falso.** O merge de três vias resolve
# esse caso perfeitamente:
#
#   base:   linha1 linha2 linha3
#   main:   linha1 linha2 linha3 + FIX
#   branch: PATCH + linha1 linha2 linha3      (derivada da base antiga)
#   merge:  PATCH + linha1 linha2 linha3 + FIX    ← o FIX sobrevive
#
# O bloqueio, portanto, reprovava trabalho legítimo — e chegou a barrar uma branch
# real de outra sessão por colidir em `CHANGELOG.md`, arquivo que colide sempre e
# cujo merge o git resolve ou marca como conflito normal.
#
# Pior: ele NÃO pegava o caso em que a perda de fato acontece, que é o oposto —
# uma branch EM DIA com `main` cujo commit sobrescreve um arquivo inteiro com uma
# versão antiga (um `cp` malfeito, por exemplo). Ali o diff carrega a remoção
# explícita das linhas novas, o merge a aplica, e o conteúdo de `main` some sem
# conflito. Estar em dia com `main` era justamente o que fazia o gate v1 nem olhar.
#
# Não existe forma confiável de distinguir esse caso de uma remoção deliberada —
# as duas são "a branch remove linhas que `main` tem". Então isto aqui **não
# bloqueia**: informa, com o que é verificável, e deixa a decisão com quem sabe o
# que pretendia fazer. Detalhes na skill `estado-compartilhado-multi-agente`.
# -----------------------------------------------------------------------------
avisa_base() {
    skipped base && return 0
    local remoto="${1:-origin}"

    git fetch -q "$remoto" main 2>/dev/null || return 0
    local main_sha base_sha atras
    main_sha=$(git rev-parse "${remoto}/main" 2>/dev/null) || return 0
    base_sha=$(git merge-base HEAD "$main_sha" 2>/dev/null) || return 0
    [ "$base_sha" = "$main_sha" ] && return 0   # em dia: nada a dizer

    atras=$(git rev-list --count "$base_sha".."$main_sha" 2>/dev/null)
    echo -e "${YELLOW}ℹ️  base: esta branch está ${atras} commit(s) atrás de ${remoto}/main.${NC}"

    # `merge-tree --write-tree` simula o merge sem tocar em nada e sai não-zero se
    # houver conflito. Saber disso ANTES do PR é o valor prático deste aviso.
    local saida
    if ! saida=$(git merge-tree --write-tree "$main_sha" HEAD 2>/dev/null); then
        local arquivos
        arquivos=$(printf '%s\n' "$saida" | awk '$3 ~ /^[123]$/ {print $4}' | sort -u | tr '\n' ' ')
        echo -e "${YELLOW}   O merge vai CONFLITAR em: ${arquivos}${NC}"
        echo -e "${YELLOW}   Resolva antes do PR:  git fetch ${remoto} && git rebase ${remoto}/main${NC}"
    else
        echo -e "${YELLOW}   O merge de três vias resolve sem conflito. Rebase é opcional.${NC}"
    fi
}
avisa_base "$1"


valida_baseline_gitleaks

run_gate gitleaks gate_gitleaks

# =============================================================================
# Gate 2 — Trivy (SCA). O mesmo severity da esteira remota, mas aqui bloqueando
# de verdade — lá o resultado vira `::warning::`.
# =============================================================================
gate_trivy() {
    precisa_de trivy "brew install trivy (macOS) · https://trivy.dev/latest/getting-started/installation/" || return 127
    trivy fs --scanners vuln --severity CRITICAL,HIGH --exit-code 1 \
        --no-progress --quiet --skip-dirs node_modules --skip-dirs target .
}
run_gate trivy gate_trivy

# =============================================================================
# Gate 3 — Semgrep (SAST). Mesmo `--exclude-rule` do workflow, para que local e
# remoto não divirjam num achado que já foi triado.
# =============================================================================
gate_semgrep() {
    precisa_de semgrep "pipx install semgrep (ou pip install semgrep)" || return 127
    semgrep scan --config auto --error --quiet \
        --exclude-rule python.lang.security.audit.dynamic-urllib-use-detected.dynamic-urllib-use-detected .
}
run_gate semgrep gate_semgrep

# =============================================================================
# Gates 4-6 — específicos por stack. O mesmo arquivo serve a vários repositórios
# (era assim com o hook de gitleaks); o que muda é a stack detectada.
# =============================================================================

if [ -f "Cargo.toml" ]; then
    # ---------- Rust ----------
    # `cargo clippy` faz a checagem de tipos do `cargo check` e os lints de uma vez,
    # sobre o mesmo alvo (`--all-targets`, testes inclusive). `-D warnings`: lint
    # novo reprova o push — a dívida conhecida (33 lints) foi zerada junto com a
    # entrada deste gate, em 2026-09-13.
    gate_types() {
        precisa_de cargo "https://rustup.rs" || return 127
        if ! cargo clippy --version >/dev/null 2>&1; then
            echo "   clippy ausente — instale com: rustup component add clippy"
            return 127
        fi
        cargo clippy --offline --all-targets -- -D warnings
    }
    run_gate types gate_types

    gate_test() {
        precisa_de cargo "https://rustup.rs" || return 127
        cargo test --offline
    }
    run_gate test gate_test

    # Formatação apenas nos .rs que estão sendo enviados, pelo mesmo motivo do
    # prettier no lado Node: dívida pré-existente não pode virar bloqueio
    # retroativo de todo push.
    #
    # `rustfmt` DIRETO, nunca `cargo fmt --check -- <arquivos>` (2026-09-07):
    # o `cargo fmt` enumera os targets do crate por conta própria e IGNORA a
    # lista passada depois do `--`, então ele checava o crate inteiro e a
    # intenção acima nunca valeu. Medido: um push de dois arquivos conformes
    # reprovava com `left behind trailing whitespace` vindo de outros dez
    # arquivos antigos, e antes disso com centenas de diffs do `api.rs`.
    # A `--edition` precisa ser explícita porque o `rustfmt` cru assume 2015 e
    # erra o parse de código 2021.
    gate_lint() {
        precisa_de rustfmt "rustup component add rustfmt" || return 127
        local rs=()
        while IFS= read -r f; do
            [ -n "$f" ] && [ -f "$f" ] && case "$f" in *.rs) rs+=("$f") ;; esac
        done <<< "$CHANGED_FILES"
        [ ${#rs[@]} -eq 0 ] && { echo "nenhum .rs no push"; return 0; }
        # `skip_children=true` (2026-09-10): sem isso o `rustfmt` ATRAVESSA as
        # declarações `mod` out-of-line e verifica também os arquivos que elas
        # apontam — que não estão no push. Medido em 2026-09-08: um `+1 linha` em
        # `src/tests/mod.rs` arrastava os ~60 módulos de teste e cuspia 1075 linhas
        # de diff; passar `src/lib.rs` chegava a 55.857. A intenção declarada logo
        # acima ("apenas nos `.rs` que estão sendo enviados") nunca valia quando o
        # diff tocava um `mod.rs`, e o push era reprovado por dívida de terceiros.
        #
        # É a mesma classe do incidente do `cargo fmt` já registrado neste arquivo,
        # por mecanismo diferente: lá a ferramenta ignorava a lista e enumerava os
        # targets; aqui ela aceita a lista e expande a partir dela.
        rustfmt --edition 2021 --check --config skip_children=true "${rs[@]}"
    }
    run_gate lint gate_lint
    # Nota: `ruff` e `pytest` sobre python_workers/ NÃO estão neste hook. Rodam
    # na esteira remota (gates próprios) e ficaram de fora aqui de propósito,
    # para não ampliar escopo sem medição — registrado no README.

elif [ -f "package.json" ]; then
    # ---------- Node / SvelteKit (sp-ui-*) ----------
    # `npm run check` (svelte-check), NÃO `npx tsc --noEmit`: o tsc cru não
    # conhece as runas do Svelte 5 e acusa `Cannot find name '$state'` em
    # código correto — medido em 2026-09-06. É por isso que o gate remoto
    # precisou do `|| true`: o comando estava errado, não o código.
    gate_types() {
        precisa_de npm "https://nodejs.org (Node >= 22.13, ver .nvmrc)" || return 127
        npm run check --silent
    }
    run_gate types gate_types

    gate_test() {
        precisa_de npm "https://nodejs.org (Node >= 22.13, ver .nvmrc)" || return 127
        npm test --silent
    }
    run_gate test gate_test

    # Prettier pelo binário LOCAL do repositório (nunca `npx prettier` cru, que
    # pode resolver outra versão e divergir do script real do projeto).
    if [ -x "node_modules/.bin/prettier" ]; then
        gate_lint() {
            local alvos=()
            while IFS= read -r f; do
                [ -n "$f" ] && [ -f "$f" ] || continue
                # `.md` fica DE FORA de propósito. Medido em 2026-09-06, na primeira
                # execução real deste hook: CHANGELOG.md e README.md já eram
                # não-conformes em `main` nos 7 repositórios, então tocar em
                # qualquer um deles arrastaria de 20 a 45 linhas de reformatação
                # de entradas ANTIGAS para dentro de um commit que não tem nada a
                # ver com elas — inclusive entradas escritas por outra sessão, numa
                # working tree compartilhada. Prosa de documentação não ganha
                # segurança nem correção com prettier; código ganha legibilidade.
                case "$f" in
                    *.ts|*.js|*.mjs|*.cjs|*.svelte|*.json|*.css|*.html|*.yml|*.yaml)
                        alvos+=("$f") ;;
                esac
            done <<< "$CHANGED_FILES"
            [ ${#alvos[@]} -eq 0 ] && { echo "nenhum arquivo formatável no push"; return 0; }
            node_modules/.bin/prettier --check "${alvos[@]}"
        }
        run_gate lint gate_lint
    else
        echo -e "${YELLOW}⏭  lint: repositório sem prettier instalado (n/a)${NC}"
    fi
fi

# =============================================================================
# Radar de skills — converte a prosa das skills em sinal no momento do push
# =============================================================================
#
# Por que existe (2026-09-07): as skills que nasceram das auditorias e dos GAPs
# só valem se forem LIDAS antes do fix, e "está escrito no AGENTS.md" provou
# não bastar — nesta mesma semana um `format!()` com SQL e uma rota com query
# param novo entraram sem que a skill de segurança fosse aberta.
#
# É a mesma conversão que a ADR-030 fez com o Superpowers: prosa vira estado ou
# gate verificável, nunca cópia de texto. Aqui o gate é o "teste de 10 segundos"
# da skill `seguranca-sovereign-pair` — a tabela "se você vai mexer em X, leia
# §Y" — aplicada ao diff real do push.
#
# NÃO BLOQUEIA de propósito. A lição registrada na ADR-030 é explícita: um gate
# hostil ligado por padrão é desligado na primeira semana e nunca reavaliado.
# Casamento sintático produz falso positivo por construção (todo `Command::new`
# é suspeito, quase nenhum é bug), então isto é um RADAR: aponta o que o diff
# encostou e qual seção responde. Quem decide continua sendo quem escreveu.
#
# Para transformar em bloqueio consciente numa rodada de auditoria:
#     HARNESS_RADAR=block git push

radar_de_skills() {
    local arquivos="$CHANGED_FILES"
    [ -z "$arquivos" ] && return 0

    # Exclui do diff analisado o que é PROSA sobre os padrões, não uso deles:
    # o próprio hook (que cita `Command::new`, `Router::new`, `session_id` nas
    # regras), skills e documentação. Sem isto, o commit que introduziu este
    # radar disparou cinco alertas contra si mesmo — medido no primeiro push
    # real. Radar que grita no próprio reflexo vira ruído, e ruído é ignorado.
    local diff_add
    diff_add=$(git diff --diff-filter=ACMR -U0 "$RANGE" -- . \
        ':(exclude).githooks/*' ':(exclude)*.md' ':(exclude).agents/skills/*' ':(exclude).claude/skills/*' \
        2>/dev/null | grep '^+' | grep -v '^+++' || true)
    [ -z "$diff_add" ] && return 0

    local achados=()

    # Herestring, nunca `echo | grep -q`: o `-q` sai no primeiro casamento e
    # fecha o pipe, e o SIGPIPE resultante no `echo` tornava o radar NÃO
    # DETERMINÍSTICO — três execuções idênticas devolveram 3, 3 e 2 achados.
    # Um radar que às vezes omite o achado é pior que radar nenhum, porque
    # ninguém desconfia do silêncio.
    _casa() { grep -qE "$1" <<< "$diff_add"; }
    _add()  { achados+=("$1"); }

    # Tabela do projeto: `.harness/radar.tsv`, uma linha por padrão, separada
    # por TAB:  <diff|arquivo>  <regex ERE>  <mensagem (skill §seção — por quê)>
    # `diff` casa as linhas ADICIONADAS do push; `arquivo`, os caminhos tocados.
    # Linhas vazias e iniciadas por `#` são ignoradas. Sem tabela, sem radar.
    local tabela=".harness/radar.tsv"
    [ -f "$tabela" ] || return 0
    local tipo padrao msg
    while IFS=$'\t' read -r tipo padrao msg; do
        case "$tipo" in ''|'#'*) continue ;; esac
        if [ "$tipo" = "diff" ]; then
            _casa "$padrao" && _add "$msg"
        elif [ "$tipo" = "arquivo" ]; then
            grep -qE "$padrao" <<< "$arquivos" && _add "$msg"
        fi
    done < "$tabela"

    [ ${#achados[@]} -eq 0 ] && return 0

    echo ""
    echo -e "${YELLOW}📡 Radar de skills — o que este push encostou:${NC}"
    printf '   · %s\n' "${achados[@]}"
    echo -e "${YELLOW}   Não é reprovação. É o ponteiro pra seção que já custou uma sessão de debugging antes.${NC}"

    if [ "${HARNESS_RADAR:-}" = "block" ]; then
        echo -e "${RED}   HARNESS_RADAR=block ativo — tratando como gate.${NC}"
        return 1
    fi
    return 0
}
# Chamado DIRETO, nunca via `run_gate`: aquele captura a saída (`out=$(...)`) e
# só a imprime quando o gate FALHA. Como o radar devolve 0 por desenho, passar
# por ele engoliria a saída inteira e mostraria só um "✅ skills-radar" — um
# radar que não mostra nada, com aparência de funcionando. Medido ao testar.
if skipped skills-radar; then
    echo -e "${YELLOW}⏭  skills-radar: pulado (HARNESS_SKIP)${NC}"
else
    if ! radar_de_skills; then
        FAILED+=("skills-radar")
    fi
fi

# =============================================================================
# Veredito
# =============================================================================
echo ""
if [ ${#FAILED[@]} -gt 0 ]; then
    echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${RED}  ❌ PUSH BLOQUEADO — gate(s) reprovado(s): ${FAILED[*]}${NC}"
    echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${YELLOW}  Corrija acima. Se a exceção for consciente e você assume o risco:${NC}"
    echo -e "${YELLOW}      HARNESS_SKIP=${FAILED[0]%% *} git push${NC}"
    echo ""
    exit 1
fi
echo -e "${GREEN}✅ Todos os gates passaram — push autorizado.${NC}"
echo ""
exit 0
